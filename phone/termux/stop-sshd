#!/data/data/com.termux/files/usr/bin/sh
# stop-sshd: run by the CCTV app through Termux RUN_COMMAND (/sshd off, or the auto-off deadline).
# Stops the sshd listener so nothing listens on the network; SSH sessions already open keep running.
# Kills the PID only if it really is sshd (a stale pid file could name another process), and releases
# the Termux wake lock start-sshd took. Lives in ~/.termux/boot/ on the phone. Docs: docs/SECURITY.md.
PIDFILE=/data/data/com.termux/files/usr/var/run/sshd.pid
if [ -f "$PIDFILE" ]; then
  PID=$(cat "$PIDFILE")
  if [ -n "$PID" ] && tr '\0' ' ' < "/proc/$PID/cmdline" 2>/dev/null | grep -q sshd; then
    kill "$PID" 2>/dev/null
  fi
  rm -f "$PIDFILE"
fi
termux-wake-unlock
